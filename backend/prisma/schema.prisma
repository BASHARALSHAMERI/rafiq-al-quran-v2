model FinanceSettings {
  id                               Int      @id @default(autoincrement())
  organizationId                   Int      @unique
  baseCurrencyCode                 String   @default("YER") @db.VarChar(8)
  fiscalYearStartMonth             Int      @default(1) @db.SmallInt
  roundingPolicy                   String?  @db.VarChar(40)
  defaultCashAccountId             Int?
  defaultBankAccountId             Int?
  defaultStudentRevenueAccountId   Int?
  defaultDonationRevenueAccountId  Int?
  defaultPayrollExpenseAccountId   Int?
  defaultOperatingExpenseAccountId Int?
  createdAt                        DateTime @default(now())
  updatedAt                        DateTime @updatedAt

  organization                   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  defaultCashAccount             AccountingAccount? @relation("FinanceSettingsDefaultCash", fields: [defaultCashAccountId], references: [id])
  defaultBankAccount             AccountingAccount? @relation("FinanceSettingsDefaultBank", fields: [defaultBankAccountId], references: [id])
  defaultStudentRevenueAccount   AccountingAccount? @relation("FinanceSettingsDefaultStudentRevenue", fields: [defaultStudentRevenueAccountId], references: [id])
  defaultDonationRevenueAccount  AccountingAccount? @relation("FinanceSettingsDefaultDonationRevenue", fields: [defaultDonationRevenueAccountId], references: [id])
  defaultPayrollExpenseAccount   AccountingAccount? @relation("FinanceSettingsDefaultPayrollExpense", fields: [defaultPayrollExpenseAccountId], references: [id])
  defaultOperatingExpenseAccount AccountingAccount? @relation("FinanceSettingsDefaultOperatingExpense", fields: [defaultOperatingExpenseAccountId], references: [id])

  @@map("finance_settings")
}

model FiscalYear {
  id             Int                @id @default(autoincrement())
  organizationId Int
  year           Int
  startDate      DateTime           @db.Date
  endDate        DateTime           @db.Date
  status         FiscalPeriodStatus @default(OPEN)
  closedAt       DateTime?
  closedById     Int?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  periods      FiscalPeriod[]
  closedBy     User?          @relation("FiscalYearClosedBy", fields: [closedById], references: [id])

  @@unique([organizationId, year])
  @@index([organizationId, status])
  @@map("fiscal_years")
}

model FiscalPeriod {
  id             Int                @id @default(autoincrement())
  organizationId Int
  fiscalYearId   Int
  periodNumber   Int                @db.SmallInt
  periodName     String             @db.VarChar(60)
  startDate      DateTime           @db.Date
  endDate        DateTime           @db.Date
  status         FiscalPeriodStatus @default(OPEN)
  closedAt       DateTime?
  closedById     Int?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  fiscalYear   FiscalYear   @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  closedBy       User?          @relation("FiscalPeriodClosedBy", fields: [closedById], references: [id])
  journalEntries JournalEntry[] @relation("JournalEntryFiscalPeriod")

  @@unique([fiscalYearId, periodNumber])
  @@index([organizationId, startDate, endDate])
  @@index([organizationId, status])
  @@map("fiscal_periods")
}

enum ExpenseInvoiceStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PARTIALLY_PAID
  PAID
  VOIDED
}

enum FixedAssetStatus {
  ACTIVE
  IN_CUSTODY
  UNDER_MAINTENANCE
  DISPOSED
  LOST
  INACTIVE
}

model Supplier {
  id             Int      @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  name           String   @db.VarChar(120)
  phone          String?  @db.VarChar(32)
  address        String?  @db.VarChar(255)
  notes          String?  @db.VarChar(500)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoices     ExpenseInvoice[]
  fixedAssets  FixedAsset[]

  @@index([organizationId])
  @@unique([organizationId, name])
  @@index([isActive])
  @@map("suppliers")
}

model ExpenseCategory {
  id                  Int      @id @default(autoincrement())
  organizationId      Int      @map("organization_id")
  name                String   @db.VarChar(120)
  type                String?  @db.VarChar(60)
  accountingAccountId Int?     @map("accounting_account_id")
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accountingAccount AccountingAccount? @relation(fields: [accountingAccountId], references: [id])
  invoices          ExpenseInvoice[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("expense_categories")
}

model ExpenseInvoice {
  id             Int                  @id @default(autoincrement())
  organizationId Int                  @map("organization_id")
  centerId       Int?                 @map("center_id")
  supplierId     Int?                 @map("supplier_id")
  categoryId     Int                  @map("category_id")
  invoiceNo      String?              @map("invoice_no") @db.VarChar(80)
  invoiceDate    DateTime             @map("invoice_date") @db.Date
  dueDate        DateTime?            @map("due_date") @db.Date
  description    String               @db.VarChar(500)
  amount         Decimal              @db.Decimal(10, 2)
  status         ExpenseInvoiceStatus @default(DRAFT)
  approvedById   Int?                 @map("approved_by_id")
  approvedAt     DateTime?            @map("approved_at")
  cancelledById  Int?                 @map("cancelled_by_id")
  cancelledAt    DateTime?            @map("cancelled_at")
  cancelReason   String?              @db.VarChar(500)
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  center       Center?          @relation(fields: [centerId], references: [id])
  supplier     Supplier?        @relation(fields: [supplierId], references: [id])
  category     ExpenseCategory  @relation(fields: [categoryId], references: [id])
  approvedBy   User?            @relation("ExpenseInvoiceApprovedBy", fields: [approvedById], references: [id])
  cancelledBy  User?            @relation("ExpenseInvoiceCancelledBy", fields: [cancelledById], references: [id])
  payments     ExpensePayment[]
  fixedAssets  FixedAsset[]

  @@unique([organizationId, supplierId, invoiceNo])
  @@index([organizationId])
  @@index([centerId])
  @@index([supplierId])
  @@index([status])
  @@map("expense_invoices")
}

model ExpensePayment {
  id               Int      @id @default(autoincrement())
  organizationId   Int      @map("organization_id")
  invoiceId        Int      @map("invoice_id")
  amount           Decimal  @db.Decimal(10, 2)
  paidAt           DateTime @map("paid_at")
  financeAccountId Int?     @map("finance_account_id")
  voucherId        Int?     @map("voucher_id")
  journalEntryId   Int?     @map("journal_entry_id")
  notes            String?  @db.VarChar(500)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice        ExpenseInvoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  financeAccount FinanceAccount? @relation(fields: [financeAccountId], references: [id])
  voucher        FinanceVoucher? @relation(fields: [voucherId], references: [id])
  journalEntry   JournalEntry?   @relation(fields: [journalEntryId], references: [id])

  @@index([organizationId])
  @@index([invoiceId])
  @@map("expense_payments")
}

model AssetCategory {
  id                               Int      @id @default(autoincrement())
  organizationId                   Int      @map("organization_id")
  name                             String   @db.VarChar(120)
  assetAccountId                   Int?     @map("asset_account_id")
  depreciationExpenseAccountId     Int?     @map("depreciation_expense_account_id")
  accumulatedDepreciationAccountId Int?     @map("accumulated_depreciation_account_id")
  usefulLifeMonths                 Int?     @map("useful_life_months")
  isActive                         Boolean  @default(true) @map("is_active")
  createdAt                        DateTime @default(now()) @map("created_at")
  updatedAt                        DateTime @updatedAt @map("updated_at")

  organization                   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assetAccount                   AccountingAccount? @relation("AssetCategoryAssetAccount", fields: [assetAccountId], references: [id])
  depreciationExpenseAccount     AccountingAccount? @relation("AssetCategoryDepreciationExpenseAccount", fields: [depreciationExpenseAccountId], references: [id])
  accumulatedDepreciationAccount AccountingAccount? @relation("AssetCategoryAccumulatedDepreciationAccount", fields: [accumulatedDepreciationAccountId], references: [id])
  fixedAssets                    FixedAsset[]

  @@unique([organizationId, name])
  @@index([organizationId, isActive])
  @@index([assetAccountId])
  @@index([depreciationExpenseAccountId])
  @@index([accumulatedDepreciationAccountId])
  @@map("asset_categories")
}

model FixedAsset {
  id                        Int              @id @default(autoincrement())
  organizationId            Int              @map("organization_id")
  centerId                  Int?             @map("center_id")
  categoryId                Int              @map("category_id")
  assetCode                 String           @map("asset_code") @db.VarChar(80)
  name                      String           @db.VarChar(160)
  description               String?          @db.VarChar(500)
  purchaseDate              DateTime         @map("purchase_date") @db.Date
  purchaseCost              Decimal          @map("purchase_cost") @db.Decimal(12, 2)
  currentValue              Decimal?         @map("current_value") @db.Decimal(12, 2)
  usefulLifeMonths          Int?             @map("useful_life_months")
  status                    FixedAssetStatus @default(ACTIVE)
  location                  String?          @db.VarChar(255)
  custodianUserId           Int?             @map("custodian_user_id")
  supplierId                Int?             @map("supplier_id")
  expenseInvoiceId          Int?             @map("expense_invoice_id")
  acquisitionJournalEntryId Int?             @unique @map("acquisition_journal_entry_id")
  notes                     String?          @db.VarChar(500)
  createdAt                 DateTime         @default(now()) @map("created_at")
  updatedAt                 DateTime         @updatedAt @map("updated_at")

  organization            Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  center                  Center?                  @relation(fields: [centerId], references: [id])
  category                AssetCategory            @relation(fields: [categoryId], references: [id])
  custodian               User?                    @relation("FixedAssetCustodian", fields: [custodianUserId], references: [id])
  supplier                Supplier?                @relation(fields: [supplierId], references: [id])
  expenseInvoice          ExpenseInvoice?          @relation(fields: [expenseInvoiceId], references: [id])
  acquisitionJournalEntry JournalEntry?            @relation("AssetAcquisitionEntry", fields: [acquisitionJournalEntryId], references: [id])
  custodyLogs             AssetCustodyLog[]
  depreciationEntries     AssetDepreciationEntry[]

  @@unique([organizationId, assetCode])
  @@index([organizationId, status])
  @@index([centerId])
  @@index([categoryId])
  @@index([custodianUserId])
  @@index([supplierId])
  @@index([expenseInvoiceId])
  @@map("fixed_assets")
}

model AssetCustodyLog {
  id             Int       @id @default(autoincrement())
  organizationId Int       @map("organization_id")
  assetId        Int       @map("asset_id")
  fromUserId     Int?      @map("from_user_id")
  toUserId       Int?      @map("to_user_id")
  centerId       Int?      @map("center_id")
  assignedAt     DateTime  @map("assigned_at")
  returnedAt     DateTime? @map("returned_at")
  notes          String?   @db.VarChar(500)
  createdById    Int?      @map("created_by_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  asset        FixedAsset   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  fromUser     User?        @relation("AssetCustodyFromUser", fields: [fromUserId], references: [id])
  toUser       User?        @relation("AssetCustodyToUser", fields: [toUserId], references: [id])
  center       Center?      @relation(fields: [centerId], references: [id])
  createdBy    User?        @relation("AssetCustodyCreatedBy", fields: [createdById], references: [id])

  @@index([organizationId, assignedAt])
  @@index([assetId, assignedAt])
  @@index([toUserId])
  @@index([centerId])
  @@map("asset_custody_logs")
}

model AssetDepreciationEntry {
  id             Int      @id @default(autoincrement())
  organizationId Int      @map("organization_id")
  assetId        Int      @map("asset_id")
  periodYear     Int      @map("period_year") @db.SmallInt
  periodMonth    Int      @map("period_month") @db.SmallInt
  amount         Decimal  @db.Decimal(12, 2)
  journalEntryId Int?     @unique @map("journal_entry_id")
  notes          String?  @db.VarChar(500)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  asset        FixedAsset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  journalEntry JournalEntry? @relation("AssetDepreciationEntry", fields: [journalEntryId], references: [id])

  @@unique([assetId, periodYear, periodMonth])
  @@index([organizationId])
  @@index([assetId])
  @@map("asset_depreciation_entries")
}
