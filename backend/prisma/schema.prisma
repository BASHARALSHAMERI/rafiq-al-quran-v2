  originalCurrencyCode String?                    @db.VarChar(3)
  exchangeRateToBase   Decimal?                   @db.Decimal(18, 6)
  status               VoucherStatus              @default(DRAFT)
  accountingCategory   VoucherAccountingCategory? // FA-3.2.1: nullable — existing/payment-generated vouchers excluded from accounting posting
  attachmentStorageKey String?                    @db.VarChar(255)
  externalTransferRef  String?                    @db.VarChar(120)
  manualReferenceNo    String?                    @db.VarChar(120)
  notes                String?                    @db.VarChar(500)
  createdById          Int
  approvedById         Int?
  postedById           Int?
  submittedAt          DateTime?
  approvedAt           DateTime?
  rejectedAt           DateTime?
  rejectionReason      String?                    @db.VarChar(500)
  postedAt             DateTime?
  voidRequestedAt      DateTime?
  voidedAt             DateTime?
  voucherDate          DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  movement             FinanceAccountMovement?
  expensePayments      ExpensePayment[]
  fundTransferIn       FinanceFundTransfer?       @relation("FundTransferVoucherIn")
  fundTransferOut      FinanceFundTransfer?       @relation("FundTransferVoucherOut")
  account              FinanceAccount             @relation(fields: [accountId], references: [id])
  approvedBy           User?                      @relation("FinanceVoucherApprovedBy", fields: [approvedById], references: [id])
  center               Center?                    @relation(fields: [centerId], references: [id])
  createdBy            User                       @relation("FinanceVoucherCreatedBy", fields: [createdById], references: [id])
  donation             Donation?
  organization         Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  postedBy             User?                      @relation("FinanceVoucherPostedBy", fields: [postedById], references: [id])
