  payrollItem          PayrollItem?
  rewardItem           RewardItem?

  @@unique([organizationId, voucherNo])
  @@index([organizationId, centerId, status, createdAt])
  @@index([sourceType, sourceId])
  @@index([accountId, postedAt])
  @@map("finance_vouchers")
}

