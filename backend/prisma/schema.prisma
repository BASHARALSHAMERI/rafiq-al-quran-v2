generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id                       Int                       @id @default(autoincrement())
  name                     String                    @db.VarChar(120)
  code                     String                    @unique @db.VarChar(60)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  logoUrl                  String?                   @map("logo_url") @db.VarChar(500)
  description              String?                   @db.VarChar(500)
  address                  String?                   @db.VarChar(255)
  phone                    String?                   @db.VarChar(32)
  email                    String?                   @db.VarChar(191)
  associationLocationName  String?                   @map("association_location_name") @db.VarChar(255)
  associationAddress       String?                   @map("association_address") @db.VarChar(255)
  associationLatitude      Decimal?                  @map("association_latitude") @db.Decimal(10, 7)
  associationLongitude     Decimal?                  @map("association_longitude") @db.Decimal(10, 7)
  associationGeoRadiusMeters Int?                    @map("association_geo_radius_meters")
  activityLogs             ActivityLog[]
  accountingAccounts       AccountingAccount[]
  journalEntries           JournalEntry[]
  journalEntryLines        JournalEntryLine[]
  attendancePolicy         AttendancePolicy?
  auditLogs                AuditLog[]
  centers                  Center[]
  donations                Donation[]
  donors                   Donor[]
  ExamGradeScale           ExamGradeScale[]
  examNominationRequests   ExamNominationRequest[]
  examQuestionBankItems    ExamQuestionBankItem[]
  exams                    Exam[]
  financeMovements         FinanceAccountMovement[]
  financeAccounts          FinanceAccount[]
  financeDeductionEvents   FinanceDeductionEvent[]
  financeDeductionRules    FinanceDeductionRule[]
  financeTransfers         FinanceFundTransfer[]
  financePolicies          FinancePolicyProfile[]
  financeSettings          FinanceSettings?
  fiscalYears              FiscalYear[]
  fiscalPeriods            FiscalPeriod[]
  financeVouchers          FinanceVoucher[]
  goldenRecords            GoldenRecord[]
  graduationCandidates     GraduationCandidate[]
  groupActivities          GroupActivity[]
  libraryCategories        LibraryCategory[]
  libraryItems             LibraryItem[]
  matnCatalogs             MatnCatalog[]
  monthlyPlans             MonthlyPlan[]
  notifications            Notification[]
  payments                 Payment[]
  payrollBatches           PayrollBatch[]
  payrollProfiles          PayrollProfile[]
  reportFiles              ReportFile[]
  reportRuns               ReportRun[]
  reviewPlanSettings       ReviewPlanSettings[]
  rewardBatches            RewardBatch[]
  rewardProfiles           RewardProfile[]
  staffAttendances         StaffAttendanceRecord[]
  staffExcuses             StaffExcuseRequest[]
  staffLeaveRequests       StaffLeaveRequest[]
  staffSchedules           StaffScheduleAssignment[]
  studentFeeProfiles       StudentFeeProfile[]
  currencies               Currency[]
  exchangeRates            ExchangeRate[]
  documentSequences        DocumentSequence[]
  salaryGrades             SalaryGrade[]
  suppliers                Supplier[]
  expenseCategories        ExpenseCategory[]
  expenseInvoices          ExpenseInvoice[]
  expensePayments          ExpensePayment[]
  assetCategories          AssetCategory[]
  fixedAssets              FixedAsset[]
  assetCustodyLogs         AssetCustodyLog[]
  assetDepreciationEntries AssetDepreciationEntry[]
  staffAssignments         StaffAssignment[]

  studentYearlyAchievementSnapshots StudentYearlyAchievementSnapshot[]
  supervisorNotes                   SupervisorNote[]
  supervisorVisitLogs               SupervisorVisitLog[]
  supervisorVisitPlans              SupervisorVisitPlan[]
  tuitionPlans                      TuitionPlan[]
  users                             User[]

  @@map("organizations")
}

model Center {
  id                       Int                       @id @default(autoincrement())
  organizationId           Int
  name                     String                    @map("name_ar") @db.VarChar(120)
  code                     String                    @db.VarChar(60)
  isActive                 Boolean                   @default(true)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  gender                   Gender                    @default(MALE)
  centerAdminUserId        Int                       @map("center_admin_user_id")
  logoUrl                  String?                   @map("logo_url") @db.VarChar(500)
  timezone                 String                    @default("Asia/Aden") @db.VarChar(64)
  mosqueName               String?                   @map("mosque_name") @db.VarChar(255)
  allowedRadiusMeters      Int?                      @default(500) @map("allowed_radius_meters")
  latitude                 Decimal?                  @db.Decimal(10, 7)
  longitude                Decimal?                  @db.Decimal(10, 7)
  locationText             String?                   @map("location_text") @db.VarChar(255)
  activityLogs             ActivityLog[]
  accountingAccounts       AccountingAccount[]
  journalEntries           JournalEntry[]
  journalEntryLines        JournalEntryLine[]
  auditLogs                AuditLog[]
  centerSupervisors        CenterSupervisor[]
  centerAdmin              User                      @relation("ManagedCenters", fields: [centerAdminUserId], references: [id])
  organization             Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  circles                  Circle[]
  donations                Donation[]
  donors                   Donor[]
  examNominationRequests   ExamNominationRequest[]
  exams                    Exam[]
  financeAccounts          FinanceAccount[]
  financeDeductionEvents   FinanceDeductionEvent[]
  financeTransfersFrom     FinanceFundTransfer[]     @relation("FundTransferFromCenter")
  financeTransfersTo       FinanceFundTransfer[]     @relation("FundTransferToCenter")
  financePolicies          FinancePolicyProfile[]
  financeVouchers          FinanceVoucher[]
  goldenRecords            GoldenRecord[]
  graduationCandidates     GraduationCandidate[]
  groupActivities          GroupActivity[]
  invoices                 Invoice[]
  libraryCategories        LibraryCategory[]
  libraryItems             LibraryItem[]
  monthlyPlans             MonthlyPlan[]
  notifications            Notification[]
  payments                 Payment[]
  payrollBatches           PayrollBatch[]
  payrollItems             PayrollItem[]
  payrollProfiles          PayrollProfile[]
  prayerTimeCache          PrayerTimeCache[]
  remoteRecitationBookings RemoteRecitationBooking[]
  remoteRecitationSettings RemoteRecitationSetting[]
  remoteRecitationSlots    RemoteRecitationSlot[]
  reportFiles              ReportFile[]
  reportRuns               ReportRun[]
  rewardBatches            RewardBatch[]
  rewardItems              RewardItem[]
  rewardProfiles           RewardProfile[]
  staffAttendances         StaffAttendanceRecord[]
  staffExcuses             StaffExcuseRequest[]
  staffLeaveRequests       StaffLeaveRequest[]
  staffSchedules           StaffScheduleAssignment[]
  studentFeeProfiles       StudentFeeProfile[]
  salaryGrades             SalaryGrade[]
  expenseInvoices          ExpenseInvoice[]
  fixedAssets              FixedAsset[]
  assetCustodyLogs         AssetCustodyLog[]
  staffAssignments         StaffAssignment[]

  studentYearlyAchievementSnapshots StudentYearlyAchievementSnapshot[]
  supervisorNotes                   SupervisorNote[]
  supervisorVisitLogs               SupervisorVisitLog[]
  supervisorVisitPlanItems          SupervisorVisitPlanItem[]
  supervisorVisitPlans              SupervisorVisitPlan[]
  tuitionPlans                      TuitionPlan[]
  userCenterAccesses                UserCenterAccess[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([organizationId, timezone])
  @@unique([organizationId, name])
  @@index([centerAdminUserId])
  @@map("centers")
}

model Circle {
  id                       Int                       @id @default(autoincrement())
  centerId                 Int
  name                     String                    @map("name_ar") @db.VarChar(120)
  teacherId                Int                       @map("primary_teacher_user_id")
  isActive                 Boolean                   @default(true)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  gender                   Gender                    @default(MALE)
  circleType               CircleType                @default(HIFZ) @map("circle_type")
  mosqueName               String?                   @map("mosque_name") @db.VarChar(255)
  locationText             String?                   @map("location_text") @db.VarChar(255)
  latitude                 Decimal?                  @db.Decimal(10, 7)
  longitude                Decimal?                  @db.Decimal(10, 7)
  allowedRadiusMeters      Int?                      @map("allowed_radius_meters")
  activityLogs             ActivityLog[]
  attendanceRecords        AttendanceRecord[]
  auditLogs                AuditLog[]
  weeklyScheduleSlots      CircleScheduleSlot[]
  center                   Center                    @relation(fields: [centerId], references: [id], onDelete: Cascade)
  teacher                  User                      @relation("TeacherCircles", fields: [teacherId], references: [id])
  examAttempts             ExamAttempt[]             @relation("ExamAttemptCircle")
  examNominationRequests   ExamNominationRequest[]
  exams                    Exam[]
  followUpRecords          FollowUpRecord[]
  goldenRecords            GoldenRecord[]
  graduationCandidates     GraduationCandidate[]
  groupActivities          GroupActivity[]
  libraryItems             LibraryItem[]
  monthlyPlans             MonthlyPlan[]
  notifications            Notification[]
  remoteRecitationBookings RemoteRecitationBooking[]
  remoteRecitationSetting  RemoteRecitationSetting?
  remoteRecitationSlots    RemoteRecitationSlot[]
  reportFiles              ReportFile[]
  reportRuns               ReportRun[]
  reviewPlanSettings       ReviewPlanSettings[]      @relation("ReviewPlanSettingsCircle")
  rewardItems              RewardItem[]
  staffSchedules           StaffScheduleAssignment[]
  staffAssignments         StaffAssignment[]
  enrollments              StudentCircleEnrollment[]

  studentYearlyAchievementSnapshots StudentYearlyAchievementSnapshot[]
  supervisorNotes                   SupervisorNote[]
  supervisorVisitLogs               SupervisorVisitLog[]
  supervisorVisitPlanItems          SupervisorVisitPlanItem[]
  userCircleAccesses                UserCircleAccess[]

  @@unique([centerId, name])
  @@index([centerId])
  @@index([teacherId])
  @@index([gender])
  @@index([circleType])
  @@map("circles")
}

model CircleScheduleSlot {
  id         Int                @id @default(autoincrement())
  circleId   Int                @map("circle_id")
  dayOfWeek  Weekday            @map("day_of_week")
  mode       CircleScheduleMode @map("mode")
  fromTime   String?            @map("from_time") @db.VarChar(5)
  toTime     String?            @map("to_time") @db.VarChar(5)
  fromPrayer PrayerName?        @map("from_prayer")
  toPrayer   PrayerName?        @map("to_prayer")
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")
  circle     Circle             @relation(fields: [circleId], references: [id], onDelete: Cascade)

  @@unique([circleId, dayOfWeek])
  @@index([circleId])
  @@map("circle_schedule_slots")
}

model RemoteRecitationSetting {
  id                      Int      @id @default(autoincrement())
  centerId                Int      @map("center_id")
  circleId                Int      @unique @map("circle_id")
  isEnabled               Boolean  @default(false) @map("is_enabled")
  slotDurationMinutes     Int      @default(30) @map("slot_duration_minutes")
  bookingLeadHours        Int      @default(2) @map("booking_lead_hours")
  cancellationWindowHours Int      @default(2) @map("cancellation_window_hours")
  maxAdvanceDays          Int      @default(21) @map("max_advance_days")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")
  center                  Center   @relation(fields: [centerId], references: [id], onDelete: Cascade)
  circle                  Circle   @relation(fields: [circleId], references: [id], onDelete: Cascade)

  @@index([centerId])
  @@map("remote_recitation_settings")
}

model RemoteRecitationSlot {
  id           Int                       @id @default(autoincrement())
  centerId     Int                       @map("center_id")
  circleId     Int                       @map("circle_id")
  teacherId    Int                       @map("teacher_id")
  startsAt     DateTime                  @map("starts_at")
  endsAt       DateTime                  @map("ends_at")
  joinUrl      String                    @map("join_url") @db.VarChar(500)
  providerHost String?                   @map("provider_host") @db.VarChar(120)
  note         String?                   @db.VarChar(500)
  isActive     Boolean                   @default(true) @map("is_active")
  createdAt    DateTime                  @default(now()) @map("created_at")
  updatedAt    DateTime                  @updatedAt @map("updated_at")
  lockVersion  Int                       @default(0) @map("lock_version")
  bookings     RemoteRecitationBooking[]
  center       Center                    @relation(fields: [centerId], references: [id], onDelete: Cascade)
  circle       Circle                    @relation(fields: [circleId], references: [id], onDelete: Cascade)
  teacher      User                      @relation("RemoteRecitationSlotTeacher", fields: [teacherId], references: [id])

  @@index([centerId, startsAt])
  @@index([circleId, startsAt])
  @@index([teacherId, startsAt])
  @@index([isActive, startsAt])
  @@map("remote_recitation_slots")
}

model RemoteRecitationBooking {
  id                 Int                           @id @default(autoincrement())
  centerId           Int                           @map("center_id")
  circleId           Int                           @map("circle_id")
  slotId             Int                           @map("slot_id")
  studentId          Int                           @map("student_id")
  teacherId          Int                           @map("teacher_id")
  status             RemoteRecitationBookingStatus @default(REQUESTED)
  requestedAt        DateTime                      @default(now()) @map("requested_at")
  reviewedAt         DateTime?                     @map("reviewed_at")
  reviewNote         String?                       @map("review_note") @db.VarChar(500)
  cancelledAt        DateTime?                     @map("cancelled_at")
  cancellationReason String?                       @map("cancellation_reason") @db.VarChar(500)
  completedAt        DateTime?                     @map("completed_at")
  followUpRecordId   Int?                          @unique @map("follow_up_record_id")
  createdAt          DateTime                      @default(now()) @map("created_at")
  updatedAt          DateTime                      @updatedAt @map("updated_at")
  lockVersion        Int                           @default(0) @map("lock_version")
  center             Center                        @relation(fields: [centerId], references: [id], onDelete: Cascade)
  circle             Circle                        @relation(fields: [circleId], references: [id], onDelete: Cascade)
  followUpRecord     FollowUpRecord?               @relation("RemoteRecitationBookingFollowUp", fields: [followUpRecordId], references: [id])
  slot               RemoteRecitationSlot          @relation(fields: [slotId], references: [id], onDelete: Cascade)
  student            User                          @relation("RemoteRecitationBookingStudent", fields: [studentId], references: [id], onDelete: Cascade)
  teacher            User                          @relation("RemoteRecitationBookingTeacher", fields: [teacherId], references: [id])

  @@index([centerId, status, requestedAt])
  @@index([circleId, status, requestedAt])
  @@index([slotId])
  @@index([studentId, status, requestedAt])
  @@index([teacherId, status, requestedAt])
  @@map("remote_recitation_bookings")
}

model User {
  id                                       Int                          @id @default(autoincrement())
  organizationId                           Int
  email                                    String                       @unique @db.VarChar(191)
  fullName                                 String                       @db.VarChar(120)
  role                                     Role
  passwordHash                             String?                      @db.VarChar(255)
  isActive                                 Boolean                      @default(true)
  createdAt                                DateTime                     @default(now())
  updatedAt                                DateTime                     @updatedAt
  createdByUserId                          Int?
  lastLoginAt                              DateTime?
  username                                 String?                      @unique @db.VarChar(80)
  accountStatus                            AccountStatus                @default(ACTIVE) @map("account_status")
  activatedAt                              DateTime?                    @map("activated_at")
  activationSentAt                         DateTime?                    @map("activation_sent_at")
  activationTokenExpiresAt                 DateTime?                    @map("activation_token_expires_at")
  activationTokenHash                      String?                      @map("activation_token_hash") @db.VarChar(255)
  activityLogs                             ActivityLog[]
  postedJournalEntries                     JournalEntry[]               @relation("JournalEntryPostedBy")
  closedFiscalYears                        FiscalYear[]                 @relation("FiscalYearClosedBy")
  closedFiscalPeriods                      FiscalPeriod[]               @relation("FiscalPeriodClosedBy")
  attendanceMarked                         AttendanceRecord[]           @relation("MarkedByUser")
  attendanceAsStudent                      AttendanceRecord[]           @relation("AttendanceStudent")
  auditLogsAsActor                         AuditLog[]                   @relation("AuditActor")
  createdCenterAdminProfiles               CenterAdminProfile[]         @relation("CenterAdminProfileCreatedBy")
  centerAdminProfile                       CenterAdminProfile?
  centerSupervisorLinks                    CenterSupervisor[]           @relation("CenterSupervisorUser")
  managedCenters                           Center[]                     @relation("ManagedCenters")
  taughtCircles                            Circle[]                     @relation("TeacherCircles")
  examAttemptCommitteeAssignments          ExamAttemptCommitteeMember[] @relation("ExamAttemptCommitteeAssignedBy")
  examAttemptCommitteeMemberships          ExamAttemptCommitteeMember[] @relation("ExamAttemptCommitteeUser")
  examAttemptsApproved                     ExamAttempt[]                @relation("ExamAttemptApprovedBy")
  examAttemptsEvaluated                    ExamAttempt[]                @relation("ExamAttemptEvaluatedBy")
  examAttemptsEvaluationClosed             ExamAttempt[]                @relation("ExamAttemptEvaluationClosedBy")
  examAttemptsPublished                    ExamAttempt[]                @relation("ExamAttemptPublishedBy")
  examAttemptsAsStudent                    ExamAttempt[]                @relation("ExamAttemptStudent")
  centerApprovedExamNominationRequests     ExamNominationRequest[]      @relation("ExamNominationCenterApprovedBy")
  createdExamNominationRequests            ExamNominationRequest[]      @relation("ExamNominationCreatedBy")
  examNominationRequestsAsStudent          ExamNominationRequest[]      @relation("ExamNominationStudent")
  supervisorReviewedExamNominationRequests ExamNominationRequest[]      @relation("ExamNominationSupervisorReviewedBy")
  createdExamQuestionBankItems             ExamQuestionBankItem[]
  createdExams                             Exam[]                       @relation("ExamCreatedBy")
  financeDeductionsReviewed                FinanceDeductionEvent[]      @relation("DeductionsReviewed")
  financeDeductions                        FinanceDeductionEvent[]      @relation("UserDeductions")
  approvedFundTransfers                    FinanceFundTransfer[]        @relation("FundTransferApprovedBy")
  requestedFundTransfers                   FinanceFundTransfer[]        @relation("FundTransferRequestedBy")
  approvedFinanceVouchers                  FinanceVoucher[]             @relation("FinanceVoucherApprovedBy")
  approvedExpenseInvoices                  ExpenseInvoice[]             @relation("ExpenseInvoiceApprovedBy")
  cancelledExpenseInvoices                 ExpenseInvoice[]             @relation("ExpenseInvoiceCancelledBy")
  assetCustodiesCreated                    AssetCustodyLog[]            @relation("AssetCustodyCreatedBy")
  assetCustodiesFrom                       AssetCustodyLog[]            @relation("AssetCustodyFromUser")
  assetCustodiesTo                         AssetCustodyLog[]            @relation("AssetCustodyToUser")
  fixedAssetsInCustody                     FixedAsset[]                 @relation("FixedAssetCustodian")
  createdFinanceVouchers                   FinanceVoucher[]             @relation("FinanceVoucherCreatedBy")
  postedFinanceVouchers                    FinanceVoucher[]             @relation("FinanceVoucherPostedBy")
  followUpsAsStudent                       FollowUpRecord[]             @relation("FollowUpStudent")
  followUpsAsTeacher                       FollowUpRecord[]             @relation("FollowUpTeacher")
  approvedGoldenRecords                    GoldenRecord[]               @relation("GoldenRecordApprovedBy")
  createdGoldenRecords                     GoldenRecord[]               @relation("GoldenRecordCreatedBy")
  rejectedGoldenRecords                    GoldenRecord[]               @relation("GoldenRecordRejectedBy")
  goldenRecordsAsStudent                   GoldenRecord[]               @relation("GoldenRecordStudent")
  submittedGoldenRecords                   GoldenRecord[]               @relation("GoldenRecordSubmittedBy")
  updatedGoldenRecords                     GoldenRecord[]               @relation("GoldenRecordUpdatedBy")
  approvedGraduationCandidates             GraduationCandidate[]        @relation("GraduationCandidateApprovedBy")
  createdGraduationCandidates              GraduationCandidate[]        @relation("GraduationCandidateCreatedBy")
  deferredGraduationCandidates             GraduationCandidate[]        @relation("GraduationCandidateDeferredBy")
  rejectedGraduationCandidates             GraduationCandidate[]        @relation("GraduationCandidateRejectedBy")
  graduationCandidatesAsStudent            GraduationCandidate[]        @relation("GraduationCandidateStudent")
  updatedGraduationCandidates              GraduationCandidate[]        @relation("GraduationCandidateUpdatedBy")
  groupActivitiesAsTeacher                 GroupActivity[]              @relation("GroupActivityTeacher")
  groupActivityParticipations              GroupActivityParticipant[]   @relation("GroupActivityStudent")
  invoicesCancelled                        Invoice[]                    @relation("InvoiceCancelledBy")
  invoicesAsStudent                        Invoice[]                    @relation("InvoiceStudent")
  createdLibraryItems                      LibraryItem[]                @relation("LibraryItemCreatedBy")
  monthlyPlansAsStudent                    MonthlyPlan[]                @relation("MonthlyPlanStudent")
  monthlyPlansAsTeacher                    MonthlyPlan[]                @relation("MonthlyPlanTeacher")
  monthlyPlansApproved                     MonthlyPlan[]                @relation("MonthlyPlanApprovedBy")
  notificationsCreated                     Notification[]               @relation("NotificationCreatedBy")
  notificationsReceived                    Notification[]               @relation("NotificationRecipient")
  createdParentProfiles                    ParentProfile[]              @relation("ParentProfileCreatedBy")
  parentProfile                            ParentProfile?
  createdParentStudentLinks                ParentStudentLink[]          @relation("ParentStudentLinkCreatedBy")
  parentLinks                              ParentStudentLink[]          @relation("ParentLinks")
  childLinks                               ParentStudentLink[]          @relation("ChildLinks")
  passwordResetTokens                      PasswordResetToken[]
  receivedPayments                         Payment[]                    @relation("PaymentReceivedBy")
  approvedPayrollBatches                   PayrollBatch[]               @relation("PayrollBatchApprovedBy")
  payrollItems                             PayrollItem[]                @relation("PayrollItemBeneficiary")
  payrollProfiles                          PayrollProfile[]             @relation("PayrollProfileUser")
  approvedPayrollProfiles                  PayrollProfile[]             @relation("PayrollProfileApprovedBy")
  staffAssignments                         StaffAssignment[]            @relation("StaffAssignmentUser")
  staffAssignmentsCreated                  StaffAssignment[]            @relation("StaffAssignmentCreatedBy")
  staffAssignmentsEnded                    StaffAssignment[]            @relation("StaffAssignmentEndedBy")
  refreshTokens                            RefreshToken[]
  remoteRecitationBookingsAsStudent        RemoteRecitationBooking[]    @relation("RemoteRecitationBookingStudent")
  remoteRecitationBookingsAsTeacher        RemoteRecitationBooking[]    @relation("RemoteRecitationBookingTeacher")
  remoteRecitationSlotsAsTeacher           RemoteRecitationSlot[]       @relation("RemoteRecitationSlotTeacher")
  createdReportFiles                       ReportFile[]                 @relation("ReportFileCreatedBy")
  requestedReportRuns                      ReportRun[]                  @relation("ReportRequestedBy")
  reviewPlanSettings                       ReviewPlanSettings[]         @relation("ReviewPlanSettingsTeacher")
  approvedRewardBatches                    RewardBatch[]                @relation("RewardBatchApprovedBy")
  rewardItems                              RewardItem[]                 @relation("RewardItemBeneficiary")
  rewardProfiles                           RewardProfile[]              @relation("RewardProfileBeneficiary")
  staffAttendancesMarked                   StaffAttendanceRecord[]      @relation("StaffAttendanceMarkedBy")
  staffAttendances                         StaffAttendanceRecord[]      @relation("StaffAttendanceUser")
  staffExcusesHandled                      StaffExcuseRequest[]         @relation("StaffExcuseHandledBy")
  staffExcuses                             StaffExcuseRequest[]         @relation("StaffExcuseUser")
  staffLeavesHandled                       StaffLeaveRequest[]          @relation("StaffLeavesHandled")
  staffLeaveRequests                       StaffLeaveRequest[]          @relation("StaffLeaves")
  staffSchedules                           StaffScheduleAssignment[]    @relation("StaffSchedules")
  studentEnrollments                       StudentCircleEnrollment[]    @relation("StudentEnrollments")
  studentFeeProfiles                       StudentFeeProfile[]          @relation("StudentFeeProfileStudent")

  createdStudentProfiles       StudentProfile[]                   @relation("StudentProfileCreatedBy")
  studentProfile               StudentProfile?
  tuitionAssignments           StudentTuitionAssignment[]         @relation("StudentTuitionAssignments")
  capturedAchievementSnapshots StudentYearlyAchievementSnapshot[] @relation("AchievementSnapshotCapturedBy")
  studentAchievementSnapshots  StudentYearlyAchievementSnapshot[] @relation("AchievementSnapshotStudent")
  supervisorNotes              SupervisorNote[]                   @relation("SupervisorNotes")
  createdSupervisorProfiles    SupervisorProfile[]                @relation("SupervisorProfileCreatedBy")
  supervisorProfile            SupervisorProfile?
  supervisorVisitLogs          SupervisorVisitLog[]               @relation("SupervisorVisitLogs")
  supervisorVisitPlansCreated  SupervisorVisitPlan[]              @relation("PlansCreated")
  supervisorVisitPlans         SupervisorVisitPlan[]              @relation("SupervisorPlans")
  createdTeacherProfiles       TeacherProfile[]                   @relation("TeacherProfileCreatedBy")
  teacherProfile               TeacherProfile?
  centerAccesses               UserCenterAccess[]
  circleAccesses               UserCircleAccess[]
  createdUserProfiles          UserProfile[]                      @relation("UserProfileCreatedBy")
  profile                      UserProfile?
  createdByUser                User?                              @relation("UserCreatedBy", fields: [createdByUserId], references: [id])
  createdUsers                 User[]                             @relation("UserCreatedBy")
  organization                 Organization                       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([role])
  @@index([isActive])
  @@index([createdByUserId])
  @@index([lastLoginAt])
  @@map("users")
}

model UserProfile {
  userId          Int       @id
  fullName        String    @db.VarChar(160)
  gender          Gender
  birthDate       DateTime? @db.Date
  phone           String?   @unique @db.VarChar(32)
  address         String?   @db.VarChar(255)
  avatarUrl       String?   @db.VarChar(500)
  createdByUserId Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  phoneNormalized String?   @unique @map("phone_normalized") @db.VarChar(32)
  createdByUser   User?     @relation("UserProfileCreatedBy", fields: [createdByUserId], references: [id])
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([fullName])
  @@index([createdByUserId])
  @@map("user_profiles")
}

model TeacherProfile {
  userId          Int         @id
  hireDate        DateTime?   @db.Date
  khatmType       KhatmType?
  riwaya          RiwayaType?
  educationLevel  String?     @db.VarChar(120)
  yearsExperience Int?
  createdByUserId Int?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  createdByUser   User?       @relation("TeacherProfileCreatedBy", fields: [createdByUserId], references: [id])
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdByUserId])
  @@map("teacher_profiles")
}

model SupervisorProfile {
  userId               Int                     @id
  assignedAt           DateTime?               @db.Date
  status               SupervisorProfileStatus @default(ACTIVE)
  educationLevel       String?                 @db.VarChar(120)
  yearsExperience      Int?
  quranQualification   KhatmType?
  professionalNotes    String?                 @db.VarChar(500)
  monthlyHoursTarget   Int                     @default(80) @map("monthly_hours_target")
  monthlyVisitsTarget  Int                     @default(20) @map("monthly_visits_target")
  createdByUserId      Int?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  createdByUser        User?                   @relation("SupervisorProfileCreatedBy", fields: [createdByUserId], references: [id])
  user                 User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([createdByUserId])
  @@map("supervisor_profiles")
